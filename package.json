    "@capacitor/share": "^7.0.0",
    "@fontsource/bricolage-grotesque": "^5.0.0",
    "@fontsource/figtree": "^5.0.0",
    "@fontsource/ibm-plex-mono": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.0.0"
  }
